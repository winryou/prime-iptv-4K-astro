---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  label: string;
  icon?: string;
  h1: string;
  schema?: Record<string, unknown>[];
  crumb?: string;
  width?: number;
}
const { title, description, label, icon = 'info', h1, schema = [], crumb, width = 780 } = Astro.props;
---
<Layout title={title} description={description} schema={schema} crumb={crumb}>
  <Header slot="header" />
  <section class="section">
    <div class="container cp" style={`max-width:${width}px;`}>
      <div class="section-label"><Icon name={icon} size={14} />{label}</div>
      <h1 class="cp-title">{h1}</h1>
      <div class="cp-body"><slot /></div>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>

<style is:global>
  .cp-title { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 900; line-height: 1.15; margin: 0 0 1.25rem; }
  .cp-body h2 { font-size: 1.3rem; font-weight: 800; margin: 2.25rem 0 0.75rem; }
  .cp-body h3 { font-size: 1.05rem; font-weight: 800; margin: 1.5rem 0 0.4rem; }
  .cp-body p { color: var(--muted); line-height: 1.8; margin: 0 0 1rem; }
  .cp-body ul, .cp-body ol { color: var(--muted); padding-left: 1.4rem; display: flex; flex-direction: column; gap: 0.5rem; margin: 0 0 1.25rem; line-height: 1.7; }
  .cp-body a:not(.btn-primary):not(.btn-outline) { color: var(--brand-2); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .cp-body .btns { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.25rem 0; }
  .cp-body .box { background: var(--bg-2); border: 1px solid var(--border); border-radius: 18px; padding: 1.25rem 1.5rem; margin: 1.25rem 0; }
  .cp-body .box p:last-child { margin-bottom: 0; }
  .cp-body .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.25rem 0; }
  .cp-body .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 1.25rem 0; }
  .cp-body .tile { background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 1.1rem 1.25rem; box-shadow: var(--shadow); }
  .cp-body .tile h3, .cp-body .tile h2 { margin-top: 0; font-size: 1.05rem; font-weight: 800; }
  .cp-body .tile p { margin: 0; font-size: 0.92rem; }
  .cp-body .tile a { text-decoration: none; }
  .cp-body table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .cp-body th, .cp-body td { border-bottom: 1px solid var(--border); padding: 0.7rem 0.8rem; text-align: left; color: var(--muted); }
  .cp-body th { color: var(--text); background: var(--bg-2); }
  .cp-body details { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 0 1.25rem; margin-bottom: 0.7rem; }
  .cp-body details[open] { border-color: var(--brand-2); }
  .cp-body details summary { padding: 1rem 0; font-weight: 700; }
  .cp-body details p { margin: 0 0 1rem; }
  .cp-body .updated { font-size: 0.85rem; }
  @media (max-width: 700px) { .cp-body .grid2, .cp-body .grid3 { grid-template-columns: 1fr; } }
</style>
