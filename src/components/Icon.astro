---
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  filled?: boolean;
  title?: string;
}

const { name, size = 20, class: className = '', filled, title } = Astro.props;

const circle = (cx: number, cy: number, r: number) => `<circle cx="${cx}" cy="${cy}" r="${r}"/>`;
