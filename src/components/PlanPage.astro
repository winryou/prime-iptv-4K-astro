---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { prices, durations, connectionTabs, buildPlans, bonusFor, isPriced, planUrl, planLabel, planMonths, features } from '../data/pricing';
import { planCopy, commonFaqs, planExtra } from '../data/plans';

interface Props {
  months: number;
}
const { months } = Astro.props;
const SITE = 'https://primeiptv4k.ca';
const copy = planCopy[months];
const priced = isPriced(months);
const bonus = bonusFor(months);
const label = planLabel(months);
const money = (n: number) => `$${n.toFixed(2)} CAD`;
const wa = (text: string) => `https://wa.me/14062356618?text=${encodeURIComponent(text)}`;
const connLabel = (n: number) => `${n} ${n === 1 ? 'connection' : 'connections'}`;
const bonusText = bonus > 0 ? `+${bonus} ${bonus === 1 ? 'month' : 'months'} free` : '';

const tiers = priced
  ? connectionTabs.map((n) => {
      const plan = buildPlans(n).find((p) => p.months === months)!;
      return { n, price: prices[n][months], perMonth: prices[n][months] / months, savePct: plan.savePct };
    })
  : [];
const orderMsg = (n: number) =>
  priced
    ? `Hello Prime IPTV, I'd like to order the ${n}-connection, ${months}-month plan${bonus > 0 ? ` (${bonusText})` : ''} for ${money(prices[n][months])}. Please send me the payment details.`
    : `Hello Prime IPTV, I'd like to order the ${months}-month plan. Please send me the price and payment details.`;
const orderHref = wa(orderMsg(1));

const extra = planExtra[months];
const faqs = [...copy.faqs, ...extra.moreFaqs, ...commonFaqs(months)];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const url = `${SITE}${planUrl(months)}`;
const productSchema = priced
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: `Prime IPTV ${label} Subscription`,
      description: copy.description,
      image: [`${SITE}/og/iptv-subscription-${months}-${months === 1 ? 'month' : 'months'}.jpg`],
      brand: { '@type': 'Brand', name: 'Prime IPTV' },
      url,
      offers: tiers.map((t) => ({
        '@type': 'Offer',
        name: `${label}, ${connLabel(t.n)}`,
        price: t.price.toFixed(2),
        priceCurrency: 'CAD',
        availability: 'https://schema.org/InStock',
        url,
      })),
    }
  : null;
const trail = [
  { name: 'Home', item: `${SITE}/` },
  { name: 'Pricing', item: `${SITE}/pricing/` },
  { name: `IPTV ${label}`, item: url },
];

const compareRows = durations.map((m) => ({
  m,
  price: prices[1][m],
  per: prices[1][m] / m,
  service: m + bonusFor(m),
  save: buildPlans(1).find((p) => p.months === m)!.savePct,
}));
---
<Layout title={copy.title} description={copy.description} schema={productSchema ? [productSchema, faqSchema] : [faqSchema]} trail={trail}>
  <Header slot="header" />

  <section class="section pp-hero">
    <div class="container pp-grid">
      <div>
        <div class="section-label"><Icon name="card" size={14} />IPTV Subscription</div>
        <h1 class="pp-h1">{copy.h1}</h1>
        <p class="pp-intro">{copy.intro}</p>
        <ul class="pp-trust">
          <li><Icon name="check" size={18} class="ic-check" /> 25,000+ live channels &amp; 120,000+ movies and series</li>
          <li><Icon name="check" size={18} class="ic-check" /> SD, HD, FHD and 4K · EPG · sports &amp; PPV in 4K and FHD</li>
          <li><Icon name="check" size={18} class="ic-check" /> 24-hour free trial, no credit card required</li>
          <li><Icon name="check" size={18} class="ic-check" /> 7-day money-back guarantee · no contract</li>
        </ul>
      </div>

      <aside class="pp-card" aria-label={`Order the ${label} plan`}>
        <div class="pp-card-top">
          <span class="pp-plan">{label} plan</span>
          {bonus > 0 && <span class="pp-bonus"><Icon name="gift" size={14} /> {bonusText}</span>}
        </div>
        {priced ? (
          <>
            <div class="pp-price" id="ppPrice">{money(tiers[0].price)}</div>
            <div class="pp-per" id="ppPer">{money(tiers[0].perMonth)} / month · 1 connection{bonus > 0 ? ` · ${months + bonus} months of service` : ''}</div>
            <p class="pp-pick">Choose connections</p>
            <div class="pp-chips" role="group" aria-label="Number of connections">
              {tiers.map((t, i) => (
                <button type="button" class={`pp-chip${i === 0 ? ' active' : ''}`} data-n={t.n} data-price={money(t.price)} data-per={`${money(t.perMonth)} / month · ${connLabel(t.n)}${bonus > 0 ? ` · ${months + bonus} months of service` : ''}`} data-href={wa(orderMsg(t.n))}>{t.n}</button>
              ))}
            </div>
          </>
        ) : (
          <>
            <div class="pp-price pp-ask">Ask for today’s price</div>
            <p class="pp-per">Message us on WhatsApp for the current {label.toLowerCase()} price. The published plans start at {money(prices[1][3])} for 3 months.</p>
          </>
        )}
        <a href={orderHref} id="ppOrder" class="btn-primary pp-btn" target="_blank" rel="noopener"><Icon name="chat" size={18} />Order Now</a>
        <a href="/free-trial/" class="btn-outline pp-btn"><Icon name="play" size={14} />Start Free Trial</a>
        <p class="pp-note">Order Now opens WhatsApp with your plan already written in the message.</p>
      </aside>
    </div>
  </section>

  <section class="section" style="background:var(--bg-2);">
    <div class="container txt">
      <div class="section-label"><Icon name="check" size={14} />What You Get</div>
      <h2 class="section-title">What Is Included in the {label} Plan</h2>
      <div class="prose">
        <ul>
          <li><strong>25,000+ live channels</strong> and <strong>120,000+ movies and series</strong> in SD, HD, FHD and 4K (<a href="/iptv-channels/">channels</a>).</li>
          <li><strong>Sports and all PPV channels in 4K and FHD</strong> (<a href="/iptv-sports-ppv-4k/">sports and PPV</a>), plus an EPG TV guide.</li>
          <li><strong>1 to 4 connections</strong>, works with all Xtream Codes / M3U players, and with MAG boxes.</li>
          <li><strong>24/7 support</strong> and a <strong>7-day money-back guarantee</strong>.</li>
          {bonus > 0 && <li><strong>{bonusText}:</strong> you pay for {months} months and receive {months + bonus} months of service.</li>}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container txt">
      <div class="section-label"><Icon name="card" size={14} />{priced ? 'Pricing' : 'How To Order'}</div>
      <h2 class="section-title">{priced ? `${label} Plan Pricing by Number of Connections` : `How to Get the ${label} Plan`}</h2>
      <div class="prose">
        {priced ? (
          <>
            <p>Prices below are for the {label.toLowerCase()} plan. The monthly figure is the plan price divided by the {months} paid months{bonus > 0 ? `; the ${bonusText} are extra` : ''}.</p>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Connections</th><th>Plan price</th><th>Per month</th><th>{months > 3 ? 'Saving vs 3-month rate' : 'Months of service'}</th><th><span class="sr-only">Order</span></th></tr></thead>
                <tbody>
                  {tiers.map((t) => (
                    <tr>
                      <td><strong>{connLabel(t.n)}</strong></td>
                      <td><strong>{money(t.price)}</strong></td>
                      <td>{money(t.perMonth)}</td>
                      <td>{months > 3 ? `${t.savePct}%` : months + bonus}</td>
                      <td><a href={wa(orderMsg(t.n))} target="_blank" rel="noopener" class="row-order">Order Now</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p>Not sure how many connections you need? Use the <a href="/blog/how-many-iptv-connections-do-i-need/">connection chooser</a>.</p>
          </>
        ) : (
          <>
            <p>The {label.toLowerCase()} plan is available on request. Message us on WhatsApp, tell us how many connections you need (1 to 4) and we will send you the current price and the payment details.</p>
            <ol>
              <li>Press <strong>Order Now</strong> above to open WhatsApp with your message ready.</li>
              <li>Tell us how many connections you need and which device you use.</li>
              <li>Pay by credit or debit card. Your login is sent by email or WhatsApp, normally within a few minutes after payment.</li>
            </ol>
            <p>Want published prices? See the <a href="/pricing/">pricing page</a> for the 3, 6, 12 and 24-month plans.</p>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-2);">
    <div class="container txt">
      <div class="section-label"><Icon name="users" size={14} />Is It Right For You?</div>
      <h2 class="section-title">Who Is the {label} Plan For?</h2>
      <div class="prose">
        {copy.fit.map((f) => (
          <>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </>
        ))}
        <h3>Worth knowing</h3>
        <ul>
          {copy.watchOut.map((w) => <li>{w}</li>)}
        </ul>
        <div class="callout"><p>{copy.scenario}</p></div>
        <h3>{extra.deepDive.title}</h3>
        {extra.deepDive.paras.map((t) => <p>{t}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container txt">
      <div class="section-label"><Icon name="sliders" size={14} />Compare</div>
      <h2 class="section-title">{label} vs Other Plan Lengths (1 Connection)</h2>
      <div class="prose">
        <p>This table compares the published plan lengths for 1 connection. Longer plans lower the cost per month, and 6, 12 and 24-month plans include free bonus months.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Plan</th><th>Price</th><th>Per month</th><th>Months of service</th><th>Saving vs 3-month rate</th></tr></thead>
            <tbody>
              {compareRows.map((r) => (
                <tr class={r.m === months ? 'cur' : ''}>
                  <td><a href={planUrl(r.m)}>{planLabel(r.m)}</a></td>
                  <td><strong>{money(r.price)}</strong></td>
                  <td>{money(r.per)}</td>
                  <td>{r.service}</td>
                  <td>{r.save}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{extra.neighbor}</p>
        <p>Prices for 2, 3 and 4 connections are on the <a href="/pricing/">pricing page</a>. {!priced && 'The 1-month and 2-month plans are available on request via WhatsApp.'}</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-2);">
    <div class="container txt">
      <div class="section-label"><Icon name="list" size={14} />Ordering</div>
      <h2 class="section-title">How Ordering and Setup Work</h2>
      <div class="prose">
        <ol>
          <li><strong>Optional:</strong> <a href="/free-trial/">request the 24-hour free trial</a> (no credit card).</li>
          <li><strong>Press Order Now.</strong> WhatsApp opens with your plan in the message; we send the payment details.</li>
          <li><strong>Pay and set up.</strong> Your login arrives by email or WhatsApp, then follow the <a href="/setup/">device guide</a>.</li>
        </ol>
        <p>Every subscription is covered by a 7-day money-back guarantee. See the <a href="/refund/">refund policy</a>.</p>
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="container" style="text-align:center;">
      <span class="stars" role="img" aria-label="4.9 out of 5 stars">{[1,2,3,4,5].map(() => <Icon name="star" size={18} class="star-on" />)}</span>
    </div>
  </section>

  <section class="section" style="background:var(--bg-2);">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center; margin-bottom:2rem;">
        <div class="section-label"><Icon name="help" size={14} />FAQ</div>
        <h2 class="section-title">{label} IPTV Plan: Questions Answered</h2>
      </div>
      <div class="faq-list">
        {faqs.map(([q, a]) => (
          <details class="faq-item">
            <summary><span>{q}</span><span class="arrow"><Icon name="chevron" size={16} /></span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:900px;">
      <div style="text-align:center; margin-bottom:2rem;">
        <div class="section-label"><Icon name="link" size={14} />Other Plans</div>
        <h2 class="section-title">Other Prime IPTV Plan Lengths</h2>
      </div>
      <div class="other-grid">
        {planMonths.filter((m) => m !== months).map((m) => (
          <a href={planUrl(m)} class="other-card">
            <strong>IPTV {planLabel(m)}</strong>
            <span>{isPriced(m) ? `From ${money(prices[1][m])}` : 'Ask for price'}{bonusFor(m) > 0 ? ` · +${bonusFor(m)} free` : ''}</span>
          </a>
        ))}
      </div>
      <p class="more-links">See all plans on the <a href="/pricing/">pricing page</a> &middot; <a href="/blog/how-many-iptv-connections-do-i-need/">how many connections you need</a> &middot; <a href="/blog/iptv-free-trial-checklist/">free-trial checklist</a> &middot; <a href="/faq/">FAQ</a></p>
    </div>
  </section>

  <section class="final">
    <div class="container" style="text-align:center;">
      <h2 class="section-title">Ready for the {label} Plan?</h2>
      <p style="color:var(--muted); margin:0 auto 1.5rem; max-width:560px;">Order on WhatsApp in a minute, or test Prime IPTV free for 24 hours first. No credit card required.</p>
      <div class="cta-row">
        <a href={orderHref} class="btn-primary final-order" target="_blank" rel="noopener"><Icon name="chat" size={18} />Order Now</a>
        <a href="/free-trial/" class="btn-outline"><Icon name="play" size={14} />Start Free Trial</a>
      </div>
    </div>
  </section>

  <div class="sticky-cta" role="region" aria-label="Order or try Prime IPTV">
    <a href={orderHref} class="btn-primary final-order" target="_blank" rel="noopener"><Icon name="chat" size={18} />Order Now</a>
    <a href="/free-trial/" class="btn-outline"><Icon name="play" size={14} />Free Trial</a>
  </div>
  <div class="sticky-spacer" aria-hidden="true"></div>

  <Footer slot="footer" />
</Layout>

<style>
  .pp-hero { background:radial-gradient(ellipse at 50% 0%, rgba(232,53,47,0.16) 0%, transparent 60%), var(--bg); }
  .pp-grid { display:grid; grid-template-columns:1.15fr 0.85fr; gap:2.5rem; align-items:start; }
  .pp-h1 { font-size:clamp(1.9rem,4.5vw,2.8rem); font-weight:900; line-height:1.15; margin:0 0 1rem; }
  .pp-intro { color:var(--muted); font-size:1.05rem; line-height:1.75; margin:0 0 1.25rem; }
  .pp-trust { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.6rem; font-size:0.95rem; }
  .pp-trust li { display:flex; gap:0.6rem; align-items:flex-start; }
  .pp-card { background:#fff; border:1.5px solid var(--brand); border-radius:16px; padding:1.5rem; box-shadow:0 10px 30px rgba(11,42,111,0.12); }
  .pp-card-top { display:flex; justify-content:space-between; align-items:center; gap:0.5rem; margin-bottom:0.75rem; }
  .pp-plan { font-weight:800; font-size:0.95rem; }
  .pp-bonus { display:inline-flex; align-items:center; gap:0.3rem; background:var(--accent); color:#fff; font-size:0.75rem; font-weight:800; padding:0.25rem 0.65rem; border-radius:999px; }
  .pp-price { font-size:2.75rem; font-weight:900; color:var(--brand); line-height:1.05; }
  .pp-ask { font-size:1.6rem; }
  .pp-per { color:var(--muted); font-size:0.88rem; margin:0.35rem 0 1rem; line-height:1.5; }
  .pp-pick { font-size:0.8rem; font-weight:700; color:var(--text); margin:0 0 0.4rem; }
  .pp-chips { display:flex; gap:0.5rem; margin-bottom:1.1rem; }
  .pp-chip { flex:1; padding:0.55rem 0; border-radius:8px; border:1.5px solid var(--border); background:#fff; color:var(--text); font-weight:800; font-size:1rem; cursor:pointer; transition:all 0.15s; }
  .pp-chip:hover { border-color:var(--brand); }
  .pp-chip.active { background:var(--brand); border-color:var(--brand); color:#fff; }
  .pp-btn { width:100%; justify-content:center; margin-top:0.6rem; font-size:1rem; }
  .pp-note { color:var(--muted); font-size:0.78rem; text-align:center; margin:0.8rem 0 0; }
  .txt { max-width:860px; margin:0 auto; }
  .txt :global(.section-label), .txt :global(.section-title) { text-align:left; }
  .row-order { color:var(--brand); font-weight:700; text-decoration:underline; text-underline-offset:2px; }
  tr.cur td { background:rgba(232,53,47,0.28); }
  .faq-list { display:flex; flex-direction:column; gap:0.75rem; }
  .faq-item { background:#fff; border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  .faq-item summary { display:flex; justify-content:space-between; align-items:center; padding:1.1rem 1.25rem; font-weight:600; font-size:0.95rem; gap:1rem; }
  .faq-item summary:hover { background:rgba(11,42,111,0.04); }
  .arrow { color:var(--muted); display:inline-flex; transition:transform 0.2s; }
  .faq-item[open] .arrow { transform:rotate(180deg); }
  .faq-item p { padding:0 1.25rem 1.1rem; color:var(--muted); font-size:0.9rem; margin:0; line-height:1.65; }
  .other-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:0.8rem; }
  .other-card { display:flex; flex-direction:column; gap:0.25rem; background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:1rem; text-decoration:none; color:var(--text); transition:border-color 0.2s; }
  .other-card:hover { border-color:var(--brand); }
  .other-card strong { font-size:0.9rem; }
  .other-card span { color:var(--muted); font-size:0.8rem; }
  .more-links { text-align:center; color:var(--muted); font-size:0.88rem; margin-top:1.5rem; }
  .more-links a { color:var(--brand); font-weight:600; }
  .proof { padding:1.5rem 1rem; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
  .proof p { margin:0.4rem 0 0; color:var(--muted); font-size:0.92rem; }
  .proof a { color:var(--brand); font-weight:600; }
  .stars { display:inline-flex; gap:2px; }
  .final { background:radial-gradient(ellipse at 50% 0%, rgba(11,42,111,0.1) 0%, transparent 60%), var(--bg-2); border-top:1px solid var(--border); padding:4rem 1rem; }
  .cta-row { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
  .sticky-cta, .sticky-spacer { display:none; }
  @media (max-width:900px) { .pp-grid { grid-template-columns:1fr; } .other-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:700px) {
    .sticky-cta { display:flex; gap:0.6rem; position:fixed; left:0; right:0; bottom:0; z-index:90; background:#fff; border-top:1px solid var(--border); padding:0.6rem 0.75rem; box-shadow:0 -4px 16px rgba(11,42,111,0.15); }
    .sticky-cta :global(a) { flex:1; justify-content:center; padding:0.7rem 0.5rem; font-size:0.9rem; }
    .sticky-spacer { display:block; height:64px; }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.pp-chip');
  const price = document.getElementById('ppPrice');
  const per = document.getElementById('ppPer');
  const links = document.querySelectorAll<HTMLAnchorElement>('#ppOrder, .final-order');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('active', x === c));
      if (price) price.textContent = c.dataset.price || '';
      if (per) per.textContent = c.dataset.per || '';
      links.forEach((a) => (a.href = c.dataset.href || a.href));
    })
  );
</script>
