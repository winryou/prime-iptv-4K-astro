    <table>
      <thead><tr><th>Appareil</th><th>Idéal pour</th><th>Guide</th></tr></thead>
      <tbody>
        <tr><td>Téléviseur intelligent</td><td>Aucun matériel de plus</td><td><a href="/fr/installation/smart-tv/">Installation sur téléviseur intelligent</a></td></tr>
        <tr><td>Firestick / Fire TV</td><td>Peu coûteux, populaire</td><td><a href="/fr/installation/firestick/">Installation sur Firestick</a></td></tr>
        <tr><td>Boîtier Android TV</td><td>Applications flexibles</td><td><a href="/fr/installation/android-tv/">Installation sur Android TV</a></td></tr>
        <tr><td>Apple TV</td><td>Foyers Apple</td><td><a href="/fr/installation/apple-tv/">Installation sur Apple TV</a></td></tr>
        <tr><td>Roku</td><td>Propriétaires de Roku</td><td><a href="/fr/installation/roku/">Installation sur Roku</a></td></tr>
