---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const groups = [
  {
    id: 'general', icon: 'info', title: 'General questions',
    items: [
      { q: 'What is IPTV?', a: 'IPTV, short for Internet Protocol Television, is TV that arrives over your internet connection instead of through cable, satellite or an antenna. A provider supplies the channels and your login, and a player app on your device displays them.' },
      { q: 'Is Prime IPTV a player app?', a: 'No. Prime IPTV (primeiptv4k.ca) is an IPTV subscription service with live TV, sports and on-demand content for viewers in Canada. Some player apps in app stores have similar names, but they are separate products. To watch Prime IPTV you add your login to a compatible IPTV player.' },
      { q: 'What is Prime IPTV?', a: 'Prime IPTV is an IPTV subscription service with 25,000+ live TV channels, 120,000+ movies and series, sports, PPV and on-demand content on compatible streaming devices. It serves Canada first and is available worldwide too.' },
      { q: 'How many channels does Prime IPTV offer?', a: 'More than 25,000 live TV channels, covering entertainment, sports, news, kids and family programming, and international content.' },
      { q: 'Which countries’ channels are included?', a: 'All Canadian and US channels and channels from other countries, including sports channels.' },
      { q: 'Does Prime IPTV have Canadian sports?', a: 'Yes. Canadian sports are included, along with US sports and sports from other countries.' },
      { q: 'Are PPV channels available in 4K?', a: 'Yes. All PPV channels are available in 4K and FHD.' },
      { q: 'How many movies and series are available?', a: 'More than 120,000 movies and series, in the VOD (video on demand) library.' },
      { q: 'What is the difference between an IPTV service and an IPTV player app?', a: 'An IPTV service provides the channels, the on-demand library and your login. A player app only displays what a service gives it and has no channels of its own. Prime IPTV is a subscription service, and you watch it through a compatible player on your device.' },
      { q: 'Is IPTV legal?', a: 'IPTV is a delivery technology, and the technology itself is not the issue. What matters is whether the content you watch is distributed with the rights to do so. You are responsible for making sure your use of any service complies with the laws and regulations that apply to you.' },
      { q: 'Is Prime IPTV available outside Canada?', a: 'Prime IPTV serves viewers across Canada and is available worldwide as well. Your experience still depends on your local internet connection.' },
    ],
  },
  {
    id: 'plans', icon: 'card', title: 'Plans, pricing and payment',
    items: [
      { q: 'Do you offer more than 4 devices?', a: 'Yes. Standard plans cover 1 to 4 devices (connections). If you need more than 4 devices, message us on WhatsApp or email us and we will quote a plan for you.' },
      { q: 'How much does Prime IPTV cost?', a: 'Plans start at $34.99 CAD for 3 months with 1 connection. Additional plans are available for 6 months ($49.99 CAD), 12 months ($79.99 CAD) and 24 months ($124.99 CAD), and with 2, 3 and 4 connections. See the pricing page for every price.' },
      { q: 'What does +1 month free and +2 months free mean?', a: '6-month and 12-month plans include 1 extra month at no charge, and 24-month plans include 2 extra months at no charge.' },
      { q: 'What is a connection, and how many do I need?', a: 'A connection is one stream playing at a time. Count the most screens that might play together on a busy evening and choose a plan with that many connections. Prime IPTV plans cover 1, 2, 3 or 4 connections.' },
      { q: 'What if I need more than 4 connections?', a: 'Message us on WhatsApp or send an email and we will suggest the best option.' },
      { q: 'How do I buy a plan?', a: 'Press Buy Now! on the plan you want. WhatsApp opens with your plan and price already in the message, and we send you the payment details.' },
      { q: 'What payment methods are accepted?', a: 'You can pay with a credit card or a debit card.' },
      { q: 'Is there a contract?', a: 'No. There is no contract, and cancellation is available.' },
    ],
  },
  {
    id: 'trial', icon: 'gift', title: 'Free trial',
    items: [
      { q: 'Does Prime IPTV offer a free trial?', a: 'Yes, there is a 24-hour free trial. Request it on WhatsApp or by email, and we send your trial details by WhatsApp or email.' },
      { q: 'Do I need a credit card for the free trial?', a: 'No. The 24-hour free trial does not require a credit card.' },
      { q: 'How should I use the 24 hours?', a: 'Install a player first, then test the channels and sports you watch most, a busy-evening slot, picture quality, the TV guide, the on-demand library and support. Our free-trial checklist covers each step.' },
      { q: 'What happens when the trial ends?', a: 'The trial ends after 24 hours. To keep watching, choose a plan on the pricing page. There is no contract.' },
    ],
  },
  {
    id: 'devices', icon: 'monitor', title: 'Devices, apps and setup',
    items: [
      { q: 'What devices does Prime IPTV support?', a: 'Prime IPTV works with compatible IPTV players on Smart TVs, Fire TV and Firestick, Android TV, Apple TV, Roku, smartphones, tablets, computers and MAG boxes.' },
      { q: 'Do I need a special box?', a: 'No. Most people use a device they already own with a compatible player app.' },
      { q: 'What IPTV players work with Prime IPTV?', a: 'Prime IPTV works with all players that accept Xtream Codes or an M3U link, such as IPTV Smarters Pro, TiviMate, IBO Player, Set IPTV and NET IPTV. Players that use your device’s MAC address (like IBO Player, Set IPTV and NET IPTV) load the playlist against that address.' },
      { q: 'How do I set up a MAG box?', a: 'Message us on WhatsApp with your MAG box MAC address. We activate your subscription and send you your portal links to enter in the box.' },
      { q: 'What should I do for a MAC-address player such as IBO Player, Set IPTV or NET IPTV?', a: 'Note the MAC address shown in the app and send it to us on WhatsApp. We will help you add your playlist.' },
      { q: 'How quickly will I receive my login?', a: 'For a paid plan, activation is normally within a few minutes after payment. Your login details arrive by email or WhatsApp.' },
      { q: 'What are Xtream Codes and M3U?', a: 'They are two common ways to log in. Xtream Codes uses a server URL, username and password. M3U uses a playlist link or file. Most players support at least one of them, and our device guides show which to use.' },
      { q: 'Why can I not find my player in my TV’s app store?', a: 'Smart TV app availability differs by brand, region and model year. Try another listed player, or connect a Firestick or Android TV box to the same TV.' },
    ],
  },
  {
    id: 'quality', icon: 'gem', title: 'Quality, features and performance',
    items: [
      { q: 'Does Prime IPTV support 4K?', a: 'Yes, for compatible content and devices. SD, HD and FHD are supported as well.' },
      { q: 'What internet speed do I need?', a: 'As a rough guide, about 5 Mbps for SD, 10 Mbps for HD, 15 Mbps for FHD and 25 Mbps or more for 4K, per screen. Multiply that by the number of screens streaming at the same time.' },
      { q: 'Does Prime IPTV have EPG?', a: 'Yes. An EPG (electronic program guide) is included.' },
      { q: 'Is Catch-Up available?', a: 'Catch-Up availability depends on the IPTV player you use. Check your player’s settings for catch-up support.' },
      { q: 'Does Prime IPTV offer sports and PPV?', a: 'Yes. Sports programming covers all major sports packages, and PPV events are available where offered.' },
      { q: 'What should I do if a channel buffers or will not load?', a: 'Check your internet speed, use a wired connection if you can, and restart the player and your router. Re-enter your login carefully too. If it still fails, contact support and tell us your device, player, channel and the time it happened. Our buffering and login guide has the full checklist.' },
      { q: 'What uptime does Prime IPTV have?', a: 'Prime IPTV runs on premium servers designed for 99.9% uptime.' },
    ],
  },
  {
    id: 'support', icon: 'headset', title: 'Support, refunds and policies',
    items: [
      { q: 'Is customer support available 24/7?', a: 'Yes. Support is available 24/7 by WhatsApp and email.' },
      { q: 'How do I contact Prime IPTV?', a: 'Message us on WhatsApp at +1 (406) 235-6618, email contactiptv.amelia@gmail.com, or call +1 (406) 235-6618. Our address is 97 Hocken Ave, Toronto, ON M6G 2K1, Canada.' },
      { q: 'Is there a money-back guarantee?', a: 'Yes. Subscriptions come with a 7-day money-back guarantee. The refund policy explains how to request a refund.' },
      { q: 'Can I cancel my subscription?', a: 'Yes. There is no contract, and cancellation is available.' },
      { q: 'Where can I read your policies?', a: 'The refund policy, terms of service, privacy policy and DMCA notice are linked in the footer of every page.' },
    ],
  },
];

const all = groups.flatMap((g) => g.items);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title="Prime IPTV FAQ: Frequently Asked Questions" description="Answers about Prime IPTV: what IPTV is, plans and pricing, the 24-hour free trial, devices and setup, quality, support, refunds and policies." schema={[faqSchema]}>
  <Header slot="header" />

  <section class="section">
    <div class="container" style="max-width:850px;">
      <div style="text-align:center; margin-bottom:2.5rem;">
        <div class="section-label"><Icon name="help" size={14} />FAQ</div>
        <h1 class="section-title">Frequently Asked Questions</h1>
        <p class="section-sub">{all.length} answers about Prime IPTV, grouped by topic. Can’t find yours? Message us any time, because support is 24/7.</p>
      </div>

      <nav class="jump" aria-label="FAQ topics">
        {groups.map((g) => <a href={`#${g.id}`} class="jump-link"><Icon name={g.icon} size={15} class="ic-accent" /> {g.title}</a>)}
      </nav>

      {groups.map((g) => (
        <div class="faq-group" id={g.id}>
          <h2><Icon name={g.icon} size={22} class="ic-accent" /> {g.title}</h2>
          <div class="faq-list">
            {g.items.map((f) => (
              <details class="faq-item">
                <summary><span>{f.q}</span><span class="arrow"><Icon name="chevron" size={16} /></span></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}

      <h2 class="guides-h"><Icon name="book" size={20} class="ic-accent" /> Helpful guides</h2>
      <div class="guide-links">
        <a href="/blog/what-is-iptv/" class="guide-link">What is IPTV? How it works</a>
        <a href="/blog/iptv-service-vs-iptv-player-app/" class="guide-link">IPTV service vs IPTV player app</a>
        <a href="/blog/how-many-iptv-connections-do-i-need/" class="guide-link">How many connections do you need?</a>
        <a href="/blog/iptv-buffering-troubleshooting/" class="guide-link">Buffering and login fixes</a>
        <a href="/blog/iptv-free-trial-checklist/" class="guide-link">24-hour free-trial checklist</a>
        <a href="/blog/best-iptv-players/" class="guide-link">Best IPTV players</a>
        <a href="/best-iptv-service-canada/" class="guide-link">Best IPTV service in Canada: why Prime IPTV wins</a>
        <a href="/4k-iptv/" class="guide-link">4K IPTV: what you need</a>
        <a href="/iptv-smarters-pro-subscription/" class="guide-link">IPTV Smarters Pro subscription</a>
        <a href="/install-iptv-smarters-pro-firestick/" class="guide-link">Install IPTV Smarters Pro on Firestick</a>
        <a href="/iptv-channels/" class="guide-link">IPTV channels: Canadian, US &amp; international</a>
        <a href="/iptv-sports-ppv-4k/" class="guide-link">Sports &amp; PPV in 4K and FHD</a>
        <a href="/iptv-internet-speed-requirements/" class="guide-link">Internet speed requirements</a>
        <a href="/setup/" class="guide-link">Device setup guides</a>
        <a href="/pricing/" class="guide-link">Pricing and plans</a>
        <a href="/about/" class="guide-link">About Prime IPTV</a>
      </div>

      <div style="text-align:center; margin-top:3rem;">
        <p style="color:var(--muted); margin-bottom:1.5rem;">Still have questions? Our support team is available 24/7.</p>
        <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
          <a href="https://wa.me/14062356618" class="btn-primary" target="_blank" rel="noopener"><Icon name="chat" size={18} /> WhatsApp Us</a>
          <a href="/free-trial/" class="btn-outline">Start Free Trial<Icon name="arrow" size={16} /></a>
          <a href="/contact/" class="btn-outline">Contact Support<Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .jump { display:flex; flex-wrap:wrap; gap:0.6rem; justify-content:center; margin-bottom:2.5rem; }
  .jump-link { display:inline-flex; align-items:center; gap:0.4rem; background:var(--bg-card); border:1px solid var(--border); border-radius:999px; padding:0.45rem 0.95rem; color:var(--text); font-size:0.85rem; font-weight:600; text-decoration:none; }
  .jump-link:hover { border-color:var(--brand); }
  .faq-group { margin-bottom:2.5rem; scroll-margin-top:90px; }
  .faq-group h2 { display:flex; align-items:center; gap:0.5rem; font-size:1.3rem; font-weight:800; margin:0 0 1rem; }
  .faq-list { display:flex; flex-direction:column; gap:0.75rem; }
  .faq-item { background:var(--bg-card); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  .faq-item summary { display:flex; justify-content:space-between; align-items:center; padding:1.1rem 1.25rem; font-weight:600; font-size:0.95rem; gap:1rem; }
  .faq-item summary:hover { background:rgba(11,42,111,0.04); }
  .arrow { color:var(--muted); display:inline-flex; transition:transform 0.2s; }
  .faq-item[open] .arrow { transform:rotate(180deg); }
  .faq-item p { padding:0 1.25rem 1.1rem; color:var(--muted); font-size:0.9rem; margin:0; line-height:1.65; }
  .guides-h { display:flex; align-items:center; gap:0.5rem; font-size:1.2rem; font-weight:800; margin:2.5rem 0 1rem; }
  .guide-links { display:grid; grid-template-columns:repeat(2,1fr); gap:0.7rem; }
  .guide-link { background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:0.8rem 1rem; color:var(--brand); font-weight:600; font-size:0.9rem; text-decoration:none; }
  .guide-link:hover { border-color:var(--brand); }
  @media (max-width:560px) { .guide-links { grid-template-columns:1fr; } }
</style>
