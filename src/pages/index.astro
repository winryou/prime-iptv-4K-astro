---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import PricingTabs from '../components/PricingTabs.astro';
import { enCities as cities } from '../data/cities';
const homeFaqs = [
  { q: 'What is IPTV?', a: 'IPTV, short for Internet Protocol Television, is TV that arrives over your internet connection instead of through cable, satellite or an antenna. You open a player app on your device and sign in with the login details from a provider like Prime IPTV.' },
  { q: 'Is Prime IPTV a player app?', a: 'No. Prime IPTV (primeiptv4k.ca) is an IPTV subscription service with live TV, sports and on-demand content for viewers in Canada. Some player apps in app stores have similar names, but they are separate products. To watch Prime IPTV you add your login to a compatible IPTV player.' },
  { q: 'What is Prime IPTV?', a: 'Prime IPTV is an IPTV subscription service for viewers in Canada, and it is available worldwide too. It includes 25,000+ live channels, 120,000+ movies and series, a TV guide (EPG), sports and PPV, in SD, HD, FHD and 4K.' },
  { q: 'Does Prime IPTV work in Canada?', a: 'Yes. Prime IPTV is built for viewers in Canada and works in every province and territory, from Toronto and Montreal to Vancouver, Calgary and Halifax. All you need is a compatible device, a player app and a stable internet connection from any Canadian provider.' },
  { q: 'Which Canadian provinces does Prime IPTV cover?', a: 'All of them: Ontario, Quebec, British Columbia, Alberta, Manitoba, Saskatchewan, Nova Scotia, New Brunswick, Newfoundland and Labrador, Prince Edward Island, and the three territories. IPTV streams over the internet, so coverage depends on your connection, not on a local cable or satellite network.' },
  { q: 'How many channels does Prime IPTV offer?', a: 'More than 25,000 live TV channels, covering entertainment, sports, news, kids and family, and international programming.' },
  { q: 'How many movies and series are available?', a: 'The on-demand (VOD) library has more than 120,000 movies and series.' },
  { q: 'How much does Prime IPTV cost?', a: 'Plans start at $34.99 for 3 months with 1 connection. You can choose 1, 2, 3 or 4 connections and 3, 6, 12 or 24 months. The 6- and 12-month plans include +1 month free, and the 24-month plans include +2 months free.' },
  { q: 'Is there a free trial, and do I need a credit card?', a: 'Yes, there is a 24-hour free trial, and it does not need a credit card.' },
  { q: 'How do I buy a plan?', a: 'Pick a plan and press Buy Now! WhatsApp opens with your plan and price already in the message. You pay by credit or debit card, and we send your login by email or WhatsApp.' },
  { q: 'How quickly will I get my login?', a: 'Activation is normally within a few minutes after payment. Your login arrives by email or WhatsApp.' },
  { q: 'What devices can I use?', a: 'Prime IPTV works with compatible IPTV players on Smart TVs, Fire TV and Firestick, Android TV, Apple TV, Roku, phones, tablets, computers and MAG boxes. Every device has its own step-by-step guide.' },
  { q: 'Do I need a special box?', a: 'No. Most people use something they already own, such as a Smart TV, a Firestick or a phone, together with a compatible player app.' },
  { q: 'What is the difference between an IPTV service and an IPTV player?', a: 'The service provides the channels and your login. The player only displays them and has no channels of its own. Prime IPTV is the service, and you watch it through a compatible player.' },
  { q: 'Does Prime IPTV support 4K?', a: 'Yes, for compatible content and devices. SD, HD and FHD are supported as well.' },
  { q: 'What internet speed do I need?', a: 'As a rough guide, you need about 5 Mbps for SD, 10 Mbps for HD, 15 Mbps for FHD and 25 Mbps or more for 4K, per screen. Multiply that by the number of screens streaming at the same time.' },
  { q: 'Do you offer more than 4 devices?', a: 'Yes. Standard plans cover 1 to 4 devices (connections). If you need more than 4 devices, message us on WhatsApp or email us and we will quote a plan for you.' },
  { q: 'How many connections do I need?', a: 'A connection is one stream playing at a time. Count the most screens that might play together. Plans cover 1 to 4 connections.' },
  { q: 'Does Prime IPTV include a TV guide and catch-up?', a: 'A TV guide (EPG) is included. Catch-up depends on the IPTV player you use.' },
  { q: 'Does Prime IPTV offer sports and PPV?', a: 'Yes. Prime IPTV includes sports across all major sports packages, plus PPV events where available.' },
  { q: 'Is there a contract, and can I cancel?', a: 'There is no contract. Cancellation is available.' },
  { q: 'Is there a money-back guarantee?', a: 'Yes. Subscriptions come with a 7-day money-back guarantee. The refund policy explains how to ask for one.' },
  { q: 'Is support available 24/7?', a: 'Yes. Support is available 24/7 by WhatsApp and email.' },
  { q: 'Is Prime IPTV available outside Canada?', a: 'Prime IPTV serves viewers across Canada and is available worldwide as well.' },
  { q: 'Which channels and countries are included?', a: 'All Canadian and US channels and channels from other countries, including sports channels, plus all PPV channels in 4K and FHD.' },
  { q: 'Does Prime IPTV have Canadian sports and PPV in 4K?', a: 'Yes. Canadian sports are included along with US sports and sports from other countries, and all PPV channels are available in 4K and FHD.' },
  { q: 'Which players work with Prime IPTV?', a: 'Any player that accepts Xtream Codes or an M3U link works, for example IPTV Smarters Pro, TiviMate, IBO Player, Set IPTV and NET IPTV. MAC-address players load the playlist against your device’s MAC address.' },
  { q: 'How do I set up a MAG box?', a: 'Message us on WhatsApp with your MAG box MAC address. We activate your subscription and send you your portal links.' },
  { q: 'How is the free trial delivered?', a: 'We send your 24-hour free trial details by WhatsApp or email. No credit card is needed.' },
  { q: 'What should I do if a channel buffers or will not load?', a: 'Check your internet speed, use a wired connection if you can, and restart your player and router. Re-enter your login carefully too. If it still fails, contact support and tell us your device, player, channel and the time it happened.' },
];
const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title="Prime IPTV Canada: Best IPTV Subscription | 4K & Free Trial" description="Prime IPTV is the IPTV subscription for Canada: 25,000+ live channels, 120,000+ movies & series, 4K, sports & PPV. 24-hour free trial, no credit card." schema={[homeFaqSchema]}>
  <Header slot="header" />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-chip"><span class="dot"></span> Now streaming across all of Canada</div>
        <h1>Prime IPTV <span class="grad">Canada</span>: premium TV, sports and movies, anywhere in the country.</h1>
        <p class="hero-sub">Prime IPTV gives Canadian viewers <strong>25,000+ live channels and 120,000+ movies and series</strong> in SD, HD, FHD and 4K, with sports, PPV and a full TV guide. No cable box, no contract.</p>
        <div class="hero-actions">
          <a href="/free-trial/" class="btn-primary"><Icon name="play" size={14} /> Start Free 24-Hour Trial</a>
          <a href="/pricing/" class="btn-ghost">See Prime IPTV Pricing<Icon name="arrow" size={16} /></a>
        </div>
        <ul class="hero-points">
          <li><Icon name="tick" size={16} /> No credit card for the trial</li>
          <li><Icon name="tick" size={16} /> 7-day money-back guarantee</li>
          <li><Icon name="tick" size={16} /> 24/7 support</li>
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="screen">
          <div class="screen-top"><span class="live"><i></i> LIVE</span><span class="res">4K UHD</span></div>
          <div class="screen-main"><span>Prime IPTV</span></div>
          <div class="screen-rows">
            <div class="row"><b></b><span>Canadian channels</span><em>Live</em></div>
            <div class="row"><b></b><span>Sports &amp; PPV</span><em>4K</em></div>
            <div class="row"><b></b><span>Movies &amp; series</span><em>VOD</em></div>
          </div>
        </div>
        <div class="float f1"><strong>25K+</strong><span>Live channels</span></div>
        <div class="float f2"><strong>120K+</strong><span>Movies &amp; series</span></div>
        <div class="float f3"><strong>10</strong><span>provinces + 3 territories</span></div>
      </div>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <section class="facts">
    <div class="container facts-grid">
      <div><strong>24-hour</strong><span>free trial</span></div>
      <div><strong>1 to 4</strong><span>connections per plan</span></div>
      <div><strong>3 to 24</strong><span>month plans</span></div>
      <div><strong>7-day</strong><span>money-back guarantee</span></div>
    </div>
  </section>

  <!-- WHAT YOU GET (BENTO) -->
  <section class="section">
    <div class="container">
      <div class="head">
        <div class="section-label"><Icon name="sparkles" size={14} />What is Prime IPTV</div>
        <h2 class="section-title">One Prime IPTV subscription replaces the cable bundle</h2>
        <p class="section-sub">IPTV is television delivered over your internet connection. With Prime IPTV you open a player app on your own device and watch, with nothing to install on your roof and no equipment rental.</p>
      </div>
      <div class="bento">
        <article class="bt bt-lg">
          <span class="bt-ic"><Icon name="tv-play" size={26} /></span>
          <h3>25,000+ live channels</h3>
          <p>All Canadian and US channels and channels from other countries, covering entertainment, news, kids and family, and international programming.</p>
          <a href="/iptv-channels/" class="bt-link">See the channel lineup<Icon name="arrow" size={14} /></a>
        </article>
        <article class="bt">
          <span class="bt-ic"><Icon name="trophy" size={26} /></span>
          <h3>Sports and PPV</h3>
          <p>Canadian, US and international sports, plus PPV channels in 4K and FHD.</p>
          <a href="/iptv-sports-ppv-4k/" class="bt-link">Sports &amp; PPV<Icon name="arrow" size={14} /></a>
        </article>
        <article class="bt">
          <span class="bt-ic"><Icon name="film" size={26} /></span>
          <h3>120,000+ movies and series</h3>
          <p>A deep on-demand library for the nights nothing is on live.</p>
        </article>
        <article class="bt">
          <span class="bt-ic"><Icon name="monitor" size={26} /></span>
          <h3>SD to 4K</h3>
          <p>SD, HD, FHD and 4K where your content and device support it.</p>
          <a href="/4k-iptv/" class="bt-link">4K IPTV<Icon name="arrow" size={14} /></a>
        </article>
        <article class="bt">
          <span class="bt-ic"><Icon name="list" size={26} /></span>
          <h3>Full TV guide (EPG)</h3>
          <p>Browse what is on now and next, like you would on cable.</p>
        </article>
        <article class="bt bt-lg bt-dark">
          <span class="bt-ic"><Icon name="headset" size={26} /></span>
          <h3>Canadian-friendly support, 24/7</h3>
          <p>Message us on WhatsApp or email any time. Setup help, login problems and plan questions all get a real answer.</p>
          <a href="/contact/" class="bt-link">Contact Prime IPTV<Icon name="arrow" size={14} /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- PROVIDER -->
  <section class="section">
    <div class="container narrow">
      <div class="head">
        <div class="section-label"><Icon name="award" size={14} />IPTV provider in Canada</div>
        <h2 class="section-title">How to choose a good IPTV provider in Canada</h2>
      </div>
      <p style="color:var(--muted); line-height:1.8;">If you are comparing IPTV providers and IPTV services in Canada, start with five checks: can you test it first, are the prices published, is there a refund policy, does it work on your devices, and can you reach support when something breaks. Prime IPTV is a Canadian-focused IPTV subscription service, built for IPTV in Canada rather than a generic worldwide list, and it covers all five: a <a href="/free-trial/" style="color:var(--brand); font-weight:600;">24-hour free trial with no credit card</a>, <a href="/pricing/" style="color:var(--brand); font-weight:600;">plans from $34.99 CAD</a>, a <a href="/refund/" style="color:var(--brand); font-weight:600;">7-day money-back guarantee</a>, support for Firestick, Smart TV, Android TV, Apple TV, phones and MAG boxes, and 24/7 help on WhatsApp. Our <a href="/best-iptv-service-canada/" style="color:var(--brand); font-weight:600;">best IPTV Canada checklist</a> shows how to compare any provider, and the <a href="/blog/iptv-cost-canada/" style="color:var(--brand); font-weight:600;">IPTV cost guide</a> explains the real monthly price.</p>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section alt" id="plans">
    <div class="container" style="text-align:center;">
      <div class="section-label"><Icon name="card" size={14} />Plans &amp; Pricing</div>
      <h2 class="section-title">Pick your Prime IPTV plan</h2>
      <p class="section-sub">Every plan includes 25,000+ channels, 120,000+ VOD, 4K, EPG, sports, PPV and 24/7 support. No contract, and you can cancel anytime.</p>
      <PricingTabs />
      <p style="color:var(--muted); margin-top:1.5rem; font-size:0.875rem;">Need more than 4 connections? <a href="/contact/" style="color:var(--brand);">Contact us</a> for custom plans.</p>
      <div style="margin-top:1.5rem;"><a href="/pricing/" class="btn-outline">Compare all plans<Icon name="arrow" size={16} /></a></div>
    </div>
  </section>

  <!-- CANADA COVERAGE -->
  <section class="section">
    <div class="container cov">
      <div class="cov-text">
        <div class="section-label"><Icon name="flag" size={14} />IPTV for Canada</div>
        <h2 class="section-title" style="text-align:left;">Made for Canadian viewers, from coast to coast</h2>
        <p style="color:var(--muted);">Prime IPTV streams over the internet, so it does not depend on a local cable or satellite network. If your home or cottage has a stable connection, you can watch, whether you are in a Toronto condo, a Calgary house or a small town in the Maritimes.</p>
        <p style="color:var(--muted);">As a rough guide you need about 5 Mbps for SD, 10 for HD, 15 for FHD and 25 or more for 4K, per screen. Check the details in our <a href="/iptv-internet-speed-requirements/" style="color:var(--brand); font-weight:600;">availability and speed guide</a>.</p>
        <div class="cov-actions">
          <a href="/best-iptv-service-canada/" class="btn-primary">Best IPTV service in Canada<Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="prov" aria-label="Provinces and territories served">
        {['Ontario','Quebec','British Columbia','Alberta','Manitoba','Saskatchewan','Nova Scotia','New Brunswick','Newfoundland & Labrador','Prince Edward Island','Yukon','Northwest Territories','Nunavut'].map((p) => <span>{p}</span>)}
      </div>
    </div>
  </section>

  <!-- CITIES -->
  <section class="section" id="cities">
    <div class="container" style="text-align:center;">
      <div class="section-label"><Icon name="map-pin" size={14} />Cities</div>
      <h2 class="section-title">IPTV near me: Prime IPTV in your Canadian city</h2>
      <p class="section-sub">Local guides for the cities our viewers watch from, with area, sports and internet tips.</p>
      <div class="city-grid">
        {cities.map((c) => <a href={`/iptv-${c.slug}/`} class="city-tile"><strong>IPTV {c.name}</strong><span>{c.province}</span></a>)}
      </div>
      <p style="margin-top:1.5rem; color:var(--muted); font-size:0.9rem;">Aussi disponible en français : <a href="/fr/" style="color:var(--brand); font-weight:600;">abonnement IPTV Canada</a>.</p>
    </div>
  </section>

  <!-- DEVICES -->
  <section class="section alt">
    <div class="container" style="text-align:center;">
      <div class="section-label"><Icon name="monitor" size={14} />Devices</div>
      <h2 class="section-title">Watch Prime IPTV on the screens you already own</h2>
      <p class="section-sub">Prime IPTV works with compatible IPTV players on all the devices below. Tap one for step-by-step setup.</p>
      <div class="devices-grid">
        <a href="/setup/smart-tv/" class="device-tile"><span class="dev-icon"><Icon name="tv" size={30} /></span><span>Smart TV</span></a>
        <a href="/setup/firestick/" class="device-tile"><span class="dev-icon"><Icon name="stick" size={30} /></span><span>Fire TV / Firestick</span></a>
        <a href="/setup/android-tv/" class="device-tile"><span class="dev-icon"><Icon name="tv-play" size={30} /></span><span>Android TV</span></a>
        <a href="/setup/apple-tv/" class="device-tile"><span class="dev-icon"><Icon name="box" size={30} /></span><span>Apple TV</span></a>
        <a href="/setup/roku/" class="device-tile"><span class="dev-icon"><Icon name="cast" size={30} /></span><span>Roku</span></a>
        <a href="/setup/mobile/" class="device-tile"><span class="dev-icon"><Icon name="smartphone" size={30} /></span><span>Phone &amp; tablet</span></a>
        <a href="/setup/computer/" class="device-tile"><span class="dev-icon"><Icon name="laptop" size={30} /></span><span>Computer</span></a>
        <a href="/setup/mag/" class="device-tile"><span class="dev-icon"><Icon name="settop" size={30} /></span><span>MAG Box</span></a>
      </div>
      <div style="margin-top:2rem;"><a href="/setup/" class="btn-outline">All setup guides<Icon name="arrow" size={16} /></a></div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <div class="section-label"><Icon name="rocket" size={14} />How it works</div>
      <h2 class="section-title">Watching in three steps</h2>
      <div class="steps">
        <div class="step"><span class="step-num">1</span><h3>Try it free</h3><p>Request your 24-hour trial on WhatsApp or by email. No credit card.</p></div>
        <div class="step"><span class="step-num">2</span><h3>Choose a plan</h3><p>Pick 1 to 4 connections and 3 to 24 months. Press Buy Now and WhatsApp opens with your plan ready.</p></div>
        <div class="step"><span class="step-num">3</span><h3>Add your login</h3><p>Enter the login we send into your player app and start watching, normally within minutes.</p></div>
      </div>
      <div style="margin-top:2.25rem;"><a href="/free-trial/" class="btn-primary"><Icon name="play" size={14} /> Start my free trial</a></div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section alt">
    <div class="container">
      <div class="head">
        <div class="section-label"><Icon name="trend" size={14} />IPTV vs cable</div>
        <h2 class="section-title">Prime IPTV vs a traditional cable or satellite package</h2>
      </div>
      <div class="cmp-wrap">
        <table class="cmp">
          <thead><tr><th></th><th class="us">Prime IPTV</th><th>Cable / satellite</th></tr></thead>
          <tbody>
            <tr><td>Contract</td><td class="us">No contract</td><td>Often a term agreement</td></tr>
            <tr><td>Equipment</td><td class="us">Your own device and a player app</td><td>Receiver or box, often rented</td></tr>
            <tr><td>Screens</td><td class="us">1 to 4 connections per plan</td><td>Extra boxes per TV</td></tr>
            <tr><td>Where you can watch</td><td class="us">Anywhere with internet</td><td>At home</td></tr>
            <tr><td>Library</td><td class="us">Live TV plus 120,000+ movies and series</td><td>Live TV plus a smaller on-demand section</td></tr>
            <tr><td>Try before you buy</td><td class="us">24-hour free trial</td><td>Rarely</td></tr>
          </tbody>
        </table>
      </div>
      <p class="cmp-note">Comparison is general. Cable and satellite offers vary by provider and region in Canada.</p>
    </div>
  </section>

  <!-- LEGAL / TRUST -->
  <section class="section">
    <div class="container narrow">
      <div class="head">
        <div class="section-label"><Icon name="shield" size={14} />Good to know</div>
        <h2 class="section-title">Is IPTV legal in Canada?</h2>
      </div>
      <p style="color:var(--muted); line-height:1.8;">IPTV is a delivery technology, and the technology itself is not the issue. What matters is whether the content you watch is properly licensed where you live. Rules differ by country and change over time, so check what applies to you. Viewers are responsible for making sure their use of the service complies with the laws and regulations that apply to them. Read our <a href="/terms/" style="color:var(--brand); font-weight:600;">terms</a>, <a href="/privacy/" style="color:var(--brand); font-weight:600;">privacy policy</a> and <a href="/refund/" style="color:var(--brand); font-weight:600;">refund policy</a> before you subscribe.</p>
    </div>
  </section>

  <!-- GUIDES -->
  <section class="section alt">
    <div class="container" style="text-align:center;">
      <div class="section-label"><Icon name="book" size={14} />Guides</div>
      <h2 class="section-title">IPTV guides for Canadian viewers</h2>
      <p class="section-sub">Plain answers on how IPTV works, how many connections you need, how to test a trial and how to fix common problems.</p>
      <div class="guides-grid">
        <a href="/blog/iptv-service-vs-iptv-player-app/" class="guide-card"><span class="guide-ic"><Icon name="monitor" size={24} /></span><strong>IPTV service vs player app</strong><p>What a subscription gives you and what a player only displays.</p></a>
        <a href="/blog/how-many-iptv-connections-do-i-need/" class="guide-card"><span class="guide-ic"><Icon name="link" size={24} /></span><strong>How many connections do you need?</strong><p>Count your screens and see which 1 to 4 connection plan fits.</p></a>
        <a href="/blog/iptv-free-trial-checklist/" class="guide-card"><span class="guide-ic"><Icon name="list" size={24} /></span><strong>24-hour free-trial checklist</strong><p>What to test so the trial answers your questions.</p></a>
        <a href="/blog/iptv-buffering-troubleshooting/" class="guide-card"><span class="guide-ic"><Icon name="wifi" size={24} /></span><strong>Buffering and login fixes</strong><p>A step-by-step checklist for freezing, login and EPG problems.</p></a>
        <a href="/blog/iptv-cost-canada/" class="guide-card"><span class="guide-ic"><Icon name="dollar" size={24} /></span><strong>IPTV cost in Canada</strong><p>What you pay per month and how to compare it with cable.</p></a>
        <a href="/blog/is-iptv-legal-in-canada/" class="guide-card"><span class="guide-ic"><Icon name="shield" size={24} /></span><strong>Is IPTV legal in Canada?</strong><p>Licensing, what to ask a provider and how to protect yourself.</p></a>
        <a href="/blog/iptv-vs-cable-canada/" class="guide-card"><span class="guide-ic"><Icon name="trend" size={24} /></span><strong>IPTV vs cable in Canada</strong><p>Cost, channels, contracts and how to switch safely.</p></a>
        <a href="/blog/iptv-box-canada/" class="guide-card"><span class="guide-ic"><Icon name="box" size={24} /></span><strong>IPTV box in Canada</strong><p>Which device to use and when a dedicated box is worth it.</p></a>
      </div>
      <div style="margin-top:2rem;"><a href="/blog/" class="btn-outline">All IPTV guides<Icon name="arrow" size={16} /></a></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <div class="head">
        <div class="section-label"><Icon name="help" size={14} />FAQ</div>
        <h2 class="section-title">Prime IPTV: your questions answered</h2>
      </div>
      <div class="faq-grid">
        {homeFaqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.q}</span><span class="faq-arrow"><Icon name="chevron" size={16} /></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div style="text-align:center; margin-top:2.5rem;"><a href="/faq/" class="btn-outline">View all FAQs<Icon name="arrow" size={16} /></a></div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final">
    <div class="container final-inner">
      <h2>Ready to try Prime IPTV in Canada?</h2>
      <p>Start the 24-hour free trial, no credit card needed, and see the channels and picture quality on your own TV.</p>
      <div class="final-actions">
        <a href="/free-trial/" class="btn-primary"><Icon name="play" size={14} /> Start free trial</a>
        <a href="/pricing/" class="btn-ghost">View pricing<Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.container.narrow { max-width: 780px; }
.head { text-align: center; margin-bottom: 2.5rem; }
.head .section-sub { margin-bottom: 0; }
.section.alt { background: var(--bg-2); }

/* HERO */
.hero { position: relative; overflow: hidden; margin-top: -4.6rem; padding: 9rem 1rem 5.5rem; color: #fff;
  background: radial-gradient(900px 500px at 85% 10%, rgba(79,123,234,0.55), transparent 60%),
