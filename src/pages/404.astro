---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page Not Found | Prime IPTV" description="The page you are looking for could not be found. Browse Prime IPTV pricing, setup guides or start a free trial." noindex>
  <Header slot="header" />
  <section class="section">
    <div class="container" style="text-align:center; max-width:640px;">
      <div class="section-label"><Icon name="compass" size={14} />Error 404</div>
      <h1 class="section-title">We couldn’t find that page</h1>
      <p style="color:var(--muted); margin-bottom:2rem;">The link may be old or mistyped. Try one of these instead:</p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn-primary">Go to Home</a>
        <a href="/pricing/" class="btn-outline">View Pricing<Icon name="arrow" size={16} /></a>
        <a href="/setup/" class="btn-outline">Setup Guides<Icon name="arrow" size={16} /></a>
        <a href="/free-trial/" class="btn-outline">Free Trial<Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>
