---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
const wa = 'https://wa.me/14062356618?text=' + encodeURIComponent('Hello Prime IPTV, I need help with my subscription.');
const topics = [
  { icon: 'rocket', t: 'Getting started', d: 'Start the free trial and install a player app.', links: [['/free-trial/','Free trial'],['/setup/','Device setup guides'],['/install-iptv-smarters-pro-firestick/','Install IPTV Smarters Pro on Firestick']] },
  { icon: 'wifi', t: 'Buffering and speed', d: 'Fix freezing, slow loading and poor picture.', links: [['/blog/iptv-buffering-troubleshooting/','Buffering and login checklist'],['/iptv-internet-speed-requirements/','Internet speed requirements']] },
  { icon: 'list', t: 'TV guide and players', d: 'EPG problems and choosing a player.', links: [['/blog/iptv-epg-explained/','IPTV EPG explained'],['/blog/best-iptv-players/','Best IPTV players'],['/iptv-smarters-pro-subscription/','IPTV Smarters Pro subscription']] },
  { icon: 'card', t: 'Orders, plans and refunds', d: 'Pricing, payment, connections and the money-back guarantee.', links: [['/pricing/','Pricing'],['/blog/how-many-iptv-connections-do-i-need/','How many connections?'],['/refund/','Refund policy']] },
];
---
<Layout title="Help Center | Prime IPTV Support in Canada" description="Prime IPTV Help Center: setup guides, buffering fixes, EPG help, ordering and refunds, plus 24/7 support by WhatsApp and email.">
  <Header slot="header" />
  <section class="section">
    <div class="container" style="max-width:900px;">
      <div class="section-label"><Icon name="headset" size={14} />Help Center</div>
      <h1>How can we help?</h1>
      <p>Find an answer below, or message us. Support is available 24/7 by WhatsApp and email.</p>
      <div class="hgrid">
        {topics.map((x) => (
          <div class="hcard">
            <span class="hic"><Icon name={x.icon} size={24} /></span>
            <h2>{x.t}</h2>
            <p>{x.d}</p>
            <ul>{x.links.map(([h, l]) => <li><a class="l" href={h}>{l}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="hcontact">
        <h2>Still stuck?</h2>
        <p>Tell us your device, player app, the channel and the time it happened, and what you see on screen. It helps us fix it faster.</p>
        <a href={wa} class="btn-primary" target="_blank" rel="noopener"><Icon name="chat" size={16} /> WhatsApp support</a>
        <a href="/contact/" class="btn-outline">Email and contact details</a>
        <p style="margin-top:1rem;"><a class="l" href="/faq/">Read the full FAQ</a></p>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>
<style>
  h1 { font-size:clamp(1.75rem,4vw,2.5rem); font-weight:900; margin:0 0 1.5rem; }
  h2 { font-size:1.15rem; font-weight:800; margin:2rem 0 0.75rem; }
  p { color:var(--muted); line-height:1.75; margin:0 0 1rem; }
  ul { color:var(--muted); padding-left:1.5rem; display:flex; flex-direction:column; gap:0.5rem; margin:0 0 1.25rem; }
  li { font-size:0.95rem; line-height:1.65; }
  a.l { color:var(--brand-2); font-weight:600; }
</style>
<style>
  .hgrid { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin-top:2rem; }
  .hcard { background:#fff; border:1px solid var(--border); border-radius:20px; padding:1.5rem; box-shadow:var(--shadow); }
  .hcard h2 { margin:0.5rem 0 0.35rem; }
  .hcard ul { margin:0.5rem 0 0; }
  .hic { display:inline-flex; width:48px; height:48px; align-items:center; justify-content:center; border-radius:14px; background:var(--bg-2); color:var(--brand-2); }
  .hcontact { margin-top:2rem; background:var(--bg-2); border-radius:22px; padding:2rem; text-align:center; }
  .hcontact h2 { margin-top:0; }
  .hcontact .btn-primary, .hcontact .btn-outline { margin:0.25rem; }
  @media (max-width:700px) { .hgrid { grid-template-columns:1fr; } }
</style>
